{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Session tool-discovery fixture",
  "description": "Schema for captured session tool-availability incidents under tests/fixtures/session-tool-discovery/.",
  "type": "object",
  "required": ["$schema", "fixtureId", "adapter", "status", "provenance", "runtimeMcpPresent", "managedGatewayConfigInjected", "gatewayTransportReached", "gatewayCredentialUsed", "globallyRegisteredTools", "reportedUnavailableTools"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./session-tool-discovery.schema.json"
    },
    "fixtureId": { "type": "string", "minLength": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "const": "captured-incident"
    },
    "provenance": {
      "type": "object",
      "required": ["source", "capturedAt", "capturedBy", "note"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "minLength": 1 },
        "capturedBy": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeMcpPresent": { "type": "boolean" },
    "managedGatewayConfigInjected": { "type": "boolean" },
    "gatewayTransportReached": {
      "type": "string",
      "enum": ["yes", "no", "unknown"],
      "description": "Whether transport evidence proves a request reached the gateway. Token-use metadata alone cannot answer this."
    },
    "gatewayCredentialUsed": { "type": "boolean" },
    "globallyRegisteredTools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Tool names the plugin manifest registered when a captured incident occurred. This freezes historical registration evidence so later manifest additions do not rewrite the incident claim."
    },
    "reportedUnavailableTools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Only plugin tools explicitly reported unavailable in the incident evidence; this is not a reconstructed tools/list capture."
    }
  }
}
